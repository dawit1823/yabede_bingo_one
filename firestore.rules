rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admins & Security Audit Logs
    match /admins/{adminId} {
      allow read, write: if true;
    }

    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // System Settings Configuration
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // User Profiles & Auth
    match /users/{userId} {
      allow read, write: if true;
    }

    match /userAuth/{userId} {
      allow read, write: if true;
    }

    match /wallets/{walletId} {
      allow read, write: if true;
    }

    // Payments & Withdrawals
    match /payments/{depositId} {
      allow read, write: if true;
    }

    match /withdrawals/{withdrawalId} {
      allow read, write: if true;
    }

    // Wallet Transactions
    match /transactions/{txId} {
      allow read, write: if true;
    }

    // Bingo Rooms, Tickets & Card Reservations
    match /rooms/{roomId} {
      allow read, write: if true;
    }

    match /tickets/{ticketId} {
      allow read, write: if true;
    }

    match /cardReservations/{resId} {
      allow read, write: if true;
    }

    // Group Games & Invitations
    match /groupGames/{groupId} {
      allow read, write: if true;
    }

    match /groupMembers/{memberId} {
      allow read, write: if true;
    }

    match /groupInvitations/{invId} {
      allow read, write: if true;
    }

    // System Notifications
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // Catch-all rule for all document paths
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
